# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Chave da API do Resend (para envio real de e-mails)
RESEND_API_KEY=

# (Opcional) No plano gratuito do Resend, configure seu e-mail verificado aqui.
# Caso contrário, o sistema tentará enviar para o e-mail extraído do currículo (o que pode gerar validation_error).
RESEND_VERIFIED_EMAIL=

# Chaves para a API do JSearch via RapidAPI
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com

# Chave para a API do Google Jobs via SerpApi
SERPAPI_API_KEY=
