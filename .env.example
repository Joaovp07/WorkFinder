# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# (Opcional) Webhook URL do Make.com para automatizar a compatibilidade com a Make (IA Connect)
# Exemplo: VITE_MAKE_WEBHOOK_URL="https://hook.us2.make.com/abc123xyz"
VITE_MAKE_WEBHOOK_URL=

# Chave da API do Groq (necessária para realizar a análise de Match das vagas)
GROQ_API_KEY=